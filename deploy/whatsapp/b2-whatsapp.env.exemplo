# /etc/b2-whatsapp.env  (permissão 640, dono root:b2). NÃO versionar o arquivo real.
# Números autorizados a conversar com o robô: DDD + número, separados por vírgula.
B2_WHATSAPP_AUTORIZADOS=42900000001,42900000002

# MODO MUDO: logado e escutando, mas SEM responder. Use em UM dos aparelhos se os dois ficarem logados
# (notebook e VM), senão cada mensagem recebe duas respostas. Descomente no que NÃO deve responder.
# B2_WHATSAPP_MUDO=1
